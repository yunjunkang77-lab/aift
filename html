<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <title>My Awesome Service</title>
</head>
<body class="bg-slate-900 text-white min-h-screen flex flex-col items-center justify-center">
    <div class="text-center p-10 bg-slate-800 rounded-3xl shadow-2xl border border-slate-700">
        <h1 class="text-4xl font-bold mb-4 text-blue-400">GitHub + Render + Neon</h1>
        <p class="text-slate-400 mb-8">성공적으로 웹 서비스가 배포되었습니다!</p>
        
        <div id="db-status" class="inline-block px-6 py-3 rounded-full bg-slate-700 text-sm font-mono">
            데이터베이스 연결 확인 중...
        </div>
    </div>

    <script>
        // 백엔드 API를 호출해 DB 연결 상태 확인
        fetch('/api/db-test')
            .then(res => res.json())
            .then(data => {
                const statusEl = document.getElementById('db-status');
                if(data.time) {
                    statusEl.innerText = `✅ Neon 연결됨: ${data.time}`;
                    statusEl.classList.add('text-green-400');
                }
            })
            .catch(() => {
                document.getElementById('db-status').innerText = "❌ DB 연결 확인 실패";
            });
    </script>
</body>
</html>
